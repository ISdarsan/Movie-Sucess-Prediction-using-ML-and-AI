# Copy this file to `.env` (git-ignored) and fill it in. NEVER commit `.env` or paste real keys anywhere else.
# The key is read by the backend only. It is never sent to the browser, returned by an API, or logged.

GEMINI_API_KEY=
# Required, no default: choose a model that your key can use. The backend never picks one for you.
GEMINI_MODEL=

# Optional limits (defaults shown)
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_INPUT_CHARS=2000
GEMINI_RATE_LIMIT_PER_MINUTE=10
