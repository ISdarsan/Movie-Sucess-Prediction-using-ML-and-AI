# Comma-separated list of browser origins allowed to call the API.
# Not needed when the site and /api share one origin (the recommended setup); required if the frontend is built with VITE_API_URL.
# Set it to your real site origin(s) in production, e.g. https://frame.example.com
FRAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional overrides (defaults resolve relative to the project root)
# FRAME_MODEL_PATH=../pre_release_movie_classifier.joblib   # the default. Do NOT point this at final_movie_classifier.joblib (post-release model): the API refuses it
# FRAME_DATA_PATH=../dataset/movie_metadata.csv
