      "reason": "Same as above."
    },
    {
      "column": "cast_total_facebook_likes",
      "timing": "maybe_before_release",
      "used": "no",
      "reason": "Same as above; aggregate of the cast's 2016 popularity."
    },
    {
      "column": "facenumber_in_poster",
      "timing": "maybe_before_release",
      "used": "no",
      "reason": "Poster artwork is a marketing asset whose timing is not recorded; weak signal, so excluded rather than assumed safe."
    },
    {
      "column": "plot_keywords",
      "timing": "after_release",
      "used": "no",
      "reason": "Keywords are user-generated on IMDb after release."
    },
    {
